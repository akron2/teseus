# The project reads process environment variables; it does not load .env files.
# Mock is the default; all remote-provider fields below are optional.
HARNESS_ENGINE=mock
HARNESS_DATA_DIR=~/.local/share/teseus-harness

# OpenAI-compatible chat completions; select with HARNESS_ENGINE=openai-compatible.
HARNESS_OPENAI_API_KEY=
HARNESS_OPENAI_BASE_URL=https://api.openai.com/v1
HARNESS_OPENAI_MODEL=
HARNESS_OPENAI_TIMEOUT=30

# Telegram is disabled unless explicitly enabled and telegram-poll is run.
HARNESS_TELEGRAM_ENABLED=false
HARNESS_TELEGRAM_BOT_TOKEN=
HARNESS_TELEGRAM_OWNER_IDS=
